+def apply_trainable_regex(model: XVLA, pattern: str):
+    """Freeze everything the pattern does not match; return (trainable, frozen) param counts."""
+    if not pattern:
+        return sum(p.numel() for p in model.parameters()), 0
+    rx = re.compile(pattern)
+    train_n = frozen_n = 0
+    for name, prm in model.named_parameters():
+        keep = bool(rx.search(name))
+        prm.requires_grad_(keep)
+        if keep:
+            train_n += prm.numel()
+        else:
+            frozen_n += prm.numel()
+    if train_n == 0:
+        raise ValueError("trainable_regex %r matched no parameters" % pattern)
+    print("[freeze] pattern %r -> trainable %.2fM, frozen %.2fM (%.1f%% trainable)"
+          % (pattern, train_n / 1e6, frozen_n / 1e6, 100 * train_n / (train_n + frozen_n)),
+          flush=True)
+    return train_n, frozen_n
+
