+def resolve_resume_checkpoint(value: str, output_dir: Path):
+    """Return a valid resumable checkpoint, or None when resume was not requested."""
+    if not value:
+        return None
+    if value != "auto":
+        candidates = [Path(value)]
+    else:
+        candidates = []
+        for path in output_dir.glob("ckpt-*"):
+            try:
+                step = int(path.name.rsplit("-", 1)[1])
+            except (IndexError, ValueError):
+                continue
+            candidates.append((step, path))
+        candidates = [path for _, path in sorted(candidates, reverse=True)]
+    for path in candidates:
+        state_path = path / "state.json"
+        accelerator_path = path / "training_state"
+        if state_path.is_file() and accelerator_path.is_dir():
+            state = json.loads(state_path.read_text())
+            if int(state.get("global_step", -1)) >= 0:
+                return path
+    if value == "auto":
+        return None
+    raise FileNotFoundError(f"checkpoint is not resumable: {value}")
+
